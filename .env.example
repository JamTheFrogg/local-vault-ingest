# ---------------------------------------------------------------
# vault-ingest settings. Copy this file to ".env" and fill it in.
# ---------------------------------------------------------------

# Full path to your Obsidian vault (the folder that contains .obsidian)
VAULT_PATH=C:\Users\YOU\Documents\Vault

# Which AI writes the summaries:
#   cloud -> Claude via API (best quality; transcript text is sent to Anthropic)
#   local -> LM Studio on this PC (everything stays local)
# Switch with:  vault-ingest mode local   /   vault-ingest mode cloud
# (or double-click windows\use-local.cmd / windows\use-cloud.cmd). Only this line changes.
LLM_MODE=cloud

# ---- cloud profile (Claude API) ----
LLM_MODEL=claude-sonnet-5-5
# Paste your key here yourself; never share it.
ANTHROPIC_API_KEY=
# Parallel AI calls in cloud mode.
LLM_CONCURRENCY=4
# DIRECT_SUMMARY_MAX_WORDS=6000

# ---- local profile (LM Studio) ----
# Load a 14B+ instruct model in LM Studio's Developer tab, then start the server.
# vault-ingest loads it with context LOCAL_CONTEXT (default 8192) and one parallel slot.
# LOCAL_BASE_URL=http://localhost:1234/v1
# "auto" = the first loaded model that isn't an embedding model; or put a model id here.
# LOCAL_MODEL=auto
# LOCAL_CONCURRENCY=1
# LOCAL_TIMEOUT=900
# Longer calls are summarized from per-part digests (keeps prompts small for local context windows).
# LOCAL_DIRECT_SUMMARY_MAX_WORDS=3000
# Context length used when vault-ingest loads the chat model (`lms load --context-length`).
# LOCAL_CONTEXT=8192
# Reasoning for the call note and the profile update. Chunk digests, client identification,
# and the evidence check stay off. Silence for 90 seconds still retries the same request once.
# LOCAL_THINKING=false
# Load the chat model before each job and unload it when the queue is empty. Embeddings are never touched.
# Set to false to leave LM Studio alone.
# LOCAL_MANAGE_MODELS=true

# Language of the notes. Leave empty to match each transcript's language.
# Examples: English | Bosnian | "English, but keep client quotes in the original language"
NOTES_LANGUAGE=

# ---- older setups (only used when LLM_MODE is not set) ----
#   LLM_PROVIDER: anthropic | openai_compat (LM Studio) | ollama
# LLM_PROVIDER=anthropic
# OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPAT_API_KEY=lm-studio
# OLLAMA_BASE_URL=http://localhost:11434

# ---- tuning (defaults are fine) ----
# CHUNK_MIN_WORDS=600
# CHUNK_MAX_WORDS=900
# CHUNK_OVERLAP_WORDS=100
# PROFILE_MAX_WORDS=1500
# LOG_KEEP_ENTRIES=15
# CLIENT_CONFIDENCE=0.75
# WATCH_DEBOUNCE_SECONDS=10
# How far a transcript's time may be off from a meeting session logged by the companion (companion.toml)
# MEETING_MATCH_TOLERANCE_MINUTES=15

# ---- local transcription (faster-whisper; Meetily is only the recorder) ----
# TRANSCRIBE_LANGUAGE=hr
# TRANSCRIBE_MODEL=large-v3
# TRANSCRIBE_DEVICE=auto
# ME_NAME=Faris
# TRANSCRIPT_SOURCE=whisper
